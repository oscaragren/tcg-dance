# Copy to .env and fill in real values. Never commit .env.

# --- App / auth ---
NODE_ENV=development
AUTH_JWT_SECRET=            # openssl rand -hex 32
APP_URL=http://localhost:5173
ADMIN_PASSWORD=

# --- Email (password reset) ---
RESEND_API_KEY=
MAIL_FROM=

# --- Card artwork storage (Cloudflare R2 or any S3-compatible bucket) ---
# Used by scripts/publish-card-art.mjs --upload. Never needed by the app
# itself at runtime — only by that one publishing script.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public base URL the bucket serves card art from, baked into the client
# build (must start with VITE_ to reach the browser). Point this at your
# R2 public bucket URL or custom domain, e.g.:
#   VITE_CARD_ART_BASE_URL=https://pub-xxxxxxxx.r2.dev/card-art
#   VITE_CARD_ART_BASE_URL=https://cards.peppelinosbar.com/card-art
VITE_CARD_ART_BASE_URL=
